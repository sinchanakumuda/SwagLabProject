pipeline {
    agent any
    
    tools {
        maven 'M2-HOME'
        jdk 'JAVA_HOME'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'master', url: 'https://github.com/sinchanakumuda/SwagLabProject.git'
            }
        }

        stage('Build') {
            steps {
                bat 'cd orangehrm-automation && mvn clean compile'
            }
        }

        stage('Test') {
            steps {
                bat 'cd orangehrm-automation && mvn test -DsuiteXmlFile=src/test/resources/crossBrowser.xml'
            }
        }

        stage('Publish Report') {
            steps {
                publishHTML(target: [
                    reportDir: 'orangehrm-automation/AdvanceReports',
                    reportFiles: 'Extentreport*.html',
                    reportName: 'Extent Report'
                ])
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'orangehrm-automation/AdvanceReports/*.html', fingerprint: true
        }
        success {
            echo 'Pipeline executed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check reports for details.'
        }
    }
}
